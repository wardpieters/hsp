table ip6 hsp_he_ingress {
  comment "hsp:ipv6-edge:v1"
%{ if length(firewall_bridges) > 0 ~}
  # A bridge traversal must not commit an untranslated zone-0 NAT binding
  # before the same packet reaches the routed tunnel postrouting hook.
  chain bridge_tracking {
    type filter hook prerouting priority -300; policy accept;
%{ for bridge in sort(keys(firewall_bridges)) ~}
    iifname "${bridge}" ct zone set 1
%{ endfor ~}
  }
%{ endif ~}
  chain prerouting {
    type nat hook prerouting priority -101; policy accept;
%{ for h in hairpin ~}
    iifname "${h.source_vnet_id}" ip6 saddr ${h.source_address} ip6 daddr ${public} ${h.protocol} dport ${h.port} dnat to ${h.target_address}
%{ endfor ~}
%{ for f in forwards ~}
    iifname "hsp-he6" ip6 daddr ${public} ${f.protocol} dport ${f.port} dnat to ${f.address}
%{ endfor ~}
  }
  chain postrouting {
    type nat hook postrouting priority 99; policy accept;
%{ for h in hairpin ~}
    oifname "${h.target_vnet_id}" ct direction original ct status dnat ct original ip6 saddr ${h.source_address} ct original ip6 daddr ${public} ct original protocol ${h.protocol == "tcp" ? 6 : 17} ct original proto-dst ${h.port} ct reply ip6 saddr ${h.target_address} ip6 saddr ${h.source_address} ip6 daddr ${h.target_address} ${h.protocol} dport ${h.port} snat to ${h.target_gateway}
%{ endfor ~}
%{ for e in egress ~}
    oifname "hsp-he6" ct direction original ip6 saddr ${e.address} meta l4proto ${e.number} %{ if e.port != null }${e.protocol} dport ${e.port} %{ endif }snat to ${public}
%{ endfor ~}
  }
  chain forward {
    type filter hook forward priority -10; policy accept;
    # Legacy fwbr bridge legs still receive native Proxmox guest filtering.
    # The routed hop is checked on the VNet/tunnel interfaces below.
    iifname "fwbr*" return
    iifname "hsp-he6" jump edge
    oifname "hsp-he6" jump edge
    ip6 saddr ${ula} jump edge
    ip6 daddr ${ula} jump edge
  }
  chain edge {
    ct state invalid drop
    # NDP is local control traffic, never routed from the HE tunnel.
    iifname != "hsp-he6" meta l4proto ipv6-icmp icmpv6 type { 135, 136 } ip6 saddr { ${ula}, fe80::/10, ::/128 } ip6 daddr { ${ula}, fe80::/10, ff02::1:ff00:0/104, ff02::1/128 } accept
    meta l4proto ipv6-icmp icmpv6 type { 130, 131, 132, 133, 134, 135, 136, 137, 143 } drop
    # A legitimate tunnel peer/router may itself be in a protected prefix.
    # Permit only errors belonging to currently authorized NAT tuples first.
%{ for f in forwards ~}
    iifname "hsp-he6" oifname "${f.vnet_id}" ct state related meta l4proto ipv6-icmp icmpv6 type { 1, 2, 3, 4 } ct status dnat ct original ip6 daddr ${public} ct original protocol ${f.protocol == "tcp" ? 6 : 17} ct original proto-dst ${f.port} ct reply ip6 saddr ${f.address} accept
    iifname "${f.vnet_id}" oifname "hsp-he6" ct state related meta l4proto ipv6-icmp icmpv6 type { 1, 2, 3, 4 } ct status dnat ct original ip6 daddr ${public} ct original protocol ${f.protocol == "tcp" ? 6 : 17} ct original proto-dst ${f.port} ct reply ip6 saddr ${f.address} accept
%{ endfor ~}
%{ for e in egress ~}
    ct state related meta l4proto ipv6-icmp icmpv6 type { 1, 2, 3, 4 } ct status snat ct original ip6 saddr ${e.address} ct reply ip6 daddr ${public} ct original protocol ${e.number} %{ if e.port != null }ct original proto-dst ${e.port} %{ endif }accept
%{ endfor ~}
%{ for h in hairpin ~}
    iifname "${h.source_vnet_id}" oifname "${h.target_vnet_id}" ct state related meta l4proto ipv6-icmp icmpv6 type { 1, 2, 3, 4 } ct status dnat ct original ip6 saddr ${h.source_address} ct original ip6 daddr ${public} ct original protocol ${h.protocol == "tcp" ? 6 : 17} ct original proto-dst ${h.port} ct reply ip6 saddr ${h.target_address} accept
    iifname "${h.target_vnet_id}" oifname "${h.source_vnet_id}" ct state related meta l4proto ipv6-icmp icmpv6 type { 1, 2, 3, 4 } ct status dnat ct original ip6 saddr ${h.source_address} ct original ip6 daddr ${public} ct original protocol ${h.protocol == "tcp" ? 6 : 17} ct original proto-dst ${h.port} ct reply ip6 saddr ${h.target_address} ct status snat ct reply ip6 daddr ${h.target_gateway} accept
%{ endfor ~}
%{ for c in protected ~}
    iifname "hsp-he6" ip6 saddr ${c} drop
    oifname "hsp-he6" ip6 daddr ${c} drop
%{ endfor ~}
%{ for f in forwards ~}
    iifname "hsp-he6" oifname "${f.vnet_id}" ct direction original ct status dnat ct original ip6 daddr ${public} ct original protocol ${f.protocol == "tcp" ? 6 : 17} ct original proto-dst ${f.port} ct reply ip6 saddr ${f.address} ip6 daddr ${f.address} ${f.protocol} dport ${f.port} ct state { new, established } accept
    iifname "${f.vnet_id}" oifname "hsp-he6" ct direction reply ct status dnat ct original ip6 daddr ${public} ct original protocol ${f.protocol == "tcp" ? 6 : 17} ct original proto-dst ${f.port} ct reply ip6 saddr ${f.address} ip6 saddr ${f.address} ${f.protocol} sport ${f.port} ct state established accept
%{ endfor ~}
%{ for h in hairpin ~}
    iifname "${h.source_vnet_id}" oifname "${h.target_vnet_id}" ct direction original ct status dnat ct original ip6 saddr ${h.source_address} ct original ip6 daddr ${public} ct original protocol ${h.protocol == "tcp" ? 6 : 17} ct original proto-dst ${h.port} ct reply ip6 saddr ${h.target_address} ip6 saddr ${h.source_address} ip6 daddr ${h.target_address} ${h.protocol} dport ${h.port} ct state { new, established } accept
    iifname "${h.target_vnet_id}" oifname "${h.source_vnet_id}" ct direction reply ct status dnat ct original ip6 saddr ${h.source_address} ct original ip6 daddr ${public} ct original protocol ${h.protocol == "tcp" ? 6 : 17} ct original proto-dst ${h.port} ct reply ip6 saddr ${h.target_address} ct status snat ct reply ip6 daddr ${h.target_gateway} ip6 saddr ${h.target_address} ip6 daddr ${h.source_address} ${h.protocol} sport ${h.port} ct state established accept
%{ endfor ~}
%{ for e in egress ~}
    iifname "${e.vnet_id}" oifname "hsp-he6" ct direction original ip6 saddr ${e.address} meta l4proto ${e.number} %{ if e.port != null }${e.protocol} dport ${e.port} %{ endif }ct state { new, established, related } accept
    ct status snat ct direction reply ct original ip6 saddr ${e.address} ct reply ip6 daddr ${public} ct original protocol ${e.number} %{ if e.port != null }ct original proto-dst ${e.port} %{ endif }ct state { established, related } accept
%{ endfor ~}
    drop
  }
}
