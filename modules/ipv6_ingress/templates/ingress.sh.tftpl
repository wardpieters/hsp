#!/bin/sh
# hsp-network-helper: scoped IPv6 NAT and connection revocation.
set -eu
umask 077
export LC_ALL=C
runtime=${RUNTIME_DIRECTORY:-/run/hsp-ipv6-ingress}
config=${CONFIGURATION_DIRECTORY:-/etc/hsp-ipv6-ingress}
table=hsp_he_ingress
owner=hsp:ipv6-edge:v1
die() { echo "$*" >&2; exit 1; }
case "${1:-}" in start|reload|stop) ;; *) die "Expected start|reload|stop" ;; esac
command -v nft >/dev/null || die "Missing prerequisite: nft; restore nft before reconciling owned state"
if current=$(nft list table ip6 "$table" 2>/dev/null); then
  [ -f "$runtime/owner" ] && echo "$current" | grep -F "$owner" >/dev/null || die "Foreign IPv6 NAT table collision"
fi
mkdir -p "$runtime"
chmod 700 "$runtime"
transaction() {
  body=$1
  { if nft list table ip6 "$table" >/dev/null 2>&1; then echo "delete table ip6 $table"; fi; cat "$body"; } > "$runtime/transaction.nft"
  nft -c -f "$runtime/transaction.nft"
  nft -f "$runtime/transaction.nft"
}
block() {
  header=$(sed -n '1p' "$runtime/owned")
  old_ula=$(printf '%s\n' "$header" | cut -d '|' -f 3)
  cat > "$runtime/block.nft" <<NFT
table ip6 $table {
 comment "$owner"
 chain forward {
  type filter hook forward priority -10; policy accept;
  iifname "hsp-he6" drop
  oifname "hsp-he6" drop
  ip6 saddr $old_ula drop
  ip6 daddr $old_ula drop
 }
}
NFT
  transaction "$runtime/block.nft"
}
delete_connections() {
  if ! conntrack "$@" > "$runtime/conntrack.log" 2>&1; then
    if grep -F '0 flow entries have been deleted' "$runtime/conntrack.log" >/dev/null && ! grep -Ei 'error|failed|not permitted' "$runtime/conntrack.log" >/dev/null; then return 0; fi
    block
    cat "$runtime/conntrack.log" >&2
    die "IPv6 conntrack cleanup failed; blocking guard retained"
  fi
}
# A journal is committed before any tuple is deleted. It survives failed stop
# and reload attempts, including failures after routed evidence is gone.
replay_connections() {
  [ -f "$runtime/hairpin-pending" ] || return 0
  while IFS='|' read -r mode source destination sport dport reply_source reply_destination translated protocol extra; do
    # Pre-upgrade eight-field journals contain TCP tuples.
    protocol=${protocol:-tcp}
    case "$protocol" in tcp|udp) ;; *) die "Malformed cleanup protocol" ;; esac
    [ -z "$extra" ] || die "Malformed cleanup journal"
    if [ "$mode" = S ]; then
      # Source bridge evidence can outlive routed state. Its grant is exact;
      # no translated target port can be inferred from this view.
      delete_connections -D -f ipv6 --zone 1 --orig-src "$source" --orig-dst "$destination" -p "$protocol" --dport "$dport"
      continue
    fi
    if [ "$mode" != B ]; then
      delete_connections -D -f ipv6 --zone 0 --orig-src "$source" --orig-dst "$destination" -p "$protocol" --sport "$sport" --dport "$dport" --reply-src "$reply_source" --reply-dst "$reply_destination"
    fi
    delete_connections -D -f ipv6 --zone 1 --orig-src "$source" --orig-dst "$destination" -p "$protocol" --sport "$sport" --dport "$dport"
    if [ "$mode" = P ]; then
      delete_connections -D -f ipv6 --zone 1 --orig-src "$reply_destination" --orig-dst "$reply_source" -p "$protocol" --sport "$translated" --dport "$dport"
    fi
  done < "$runtime/hairpin-pending"
  rm -f "$runtime/hairpin-pending"
}
snapshot_connections() {
  mode=$1 public=$2 address=$3 port=$4 target=$5 gateway=$6 protocol=$7
  set -- -L -f ipv6 --zone 0 --orig-src "$address" --orig-dst "$public" --reply-src "$target" --reply-dst "$gateway" -p "$protocol" --dport "$port" -o extended
  if [ "$mode" = E ]; then
    # E's destination is arbitrary; only the public reply destination owns it.
    set -- -L -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$public" -p "$protocol" --dport "$port" -o extended
  fi
  if [ "$mode" = B ]; then
    # Enumerate source bridge orphans independently, preserving the VIP/P view.
    set -- -L -f ipv6 --zone 1 --orig-src "$address" -p "$protocol" --dport "$port" -o extended
  fi
  conntrack "$@" > "$runtime/enumeration" || die "IPv6 conntrack enumeration failed; blocking guard retained"
  if [ "$mode" = E ]; then
    conntrack -L -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$address" -p "$protocol" --dport "$port" -o extended >> "$runtime/enumeration" || die "IPv6 conntrack enumeration failed; blocking guard retained"
  fi
  # conntrack emits the original tuple followed by its reply tuple. Reject
  # missing, duplicated, non-address or non-port fields rather than guessing.
  awk -v protocol="$protocol" -v mode="$mode" -v source="$address" -v public="$public" -v port="$port" -v target="$target" -v gateway="$gateway" '
    function address(x, groups,n,i,count,rest,compressed) {
      if(x !~ /^[0-9a-fA-F:]+$/ || x !~ /:/ || x ~ /:::/ || x ~ /^:[^:]/ || x ~ /[^:]:$/) return 0
      compressed=index(x,"::")
      rest=x
      if(compressed) {
        sub(/::/,"",rest)
        if(index(rest,"::")) return 0
      }
      n=split(x,groups,":")
      count=0
      for(i=1;i<=n;i++) {
        if(groups[i]=="") continue
        if(length(groups[i])>4) return 0
        count++
      }
      return compressed ? count<8 : count==8
    }
    function number(x) { return x ~ /^[0-9]+$/ && x >= (protocol == "udp" ? 0 : 1) && x <= 65535 }
    {
      ns=nd=nsp=ndp=0
      for(i=1;i<=NF;i++) {
        split($i, part, "=")
        if(part[1]=="src") src[++ns]=part[2]
        if(part[1]=="dst") dst[++nd]=part[2]
        if(part[1]=="sport") sp[++nsp]=part[2]
        if(part[1]=="dport") dp[++ndp]=part[2]
      }
      if(!(($1==protocol && $2==(protocol=="tcp" ? 6 : 17)) || ($1=="ipv6" && $2==10 && $3==protocol && $4==(protocol=="tcp" ? 6 : 17))) || ns!=2 || nd!=2 || nsp!=2 || ndp!=2 || !address(src[1]) || !address(src[2]) || !address(dst[1]) || !address(dst[2]) || !number(sp[1]) || !number(sp[2]) || !number(dp[1]) || !number(dp[2]) || src[1]!=source || dp[1]!=port || sp[2]!=port || (mode=="P" && (dst[1]!=public || src[2]!=target || dst[2]!=gateway)) || (mode=="E" && ((dst[2]!=public && dst[2]!=source) || dst[1]!=src[2])) || (mode=="B" && (dst[1]!=src[2] || dst[2]!=source || sp[1]!=dp[2]))) { bad=1; exit 1 }
      if(mode=="B" && dst[1]==public) next
      print mode "|" src[1] "|" dst[1] "|" sp[1] "|" dp[1] "|" src[2] "|" dst[2] "|" dp[2] "|" protocol
    }
    END { if(bad) exit 1 }
  ' "$runtime/enumeration" >> "$runtime/hairpin-next" || die "Malformed IPv6 conntrack tuple; blocking guard retained"
}
bridge_changed() {
  endpoint=$1
  { [ ! -f "$runtime/bridge-zones" ] || cat "$runtime/bridge-zones"; cat "$config/bridge-zones"; } | sort -u > "$runtime/zone-candidates"
  while IFS='|' read -r bridge candidate; do
    [ "$candidate" = "$endpoint" ] || continue
    row="$bridge|$candidate"
    if [ ! -f "$runtime/bridge-zones" ] || ! grep -Fx -- "$row" "$runtime/bridge-zones" >/dev/null || ! grep -Fx -- "$row" "$config/bridge-zones" >/dev/null; then return 0; fi
  done < "$runtime/zone-candidates"
  return 1
}
prepare_hairpin_cleanup() {
  action=$1
  replay_connections
  awk -F '|' '$1 == "P" && (NF != 9 || ($4 != "tcp" && $4 != "udp") || $9 == "") { exit 1 }' "$runtime/owned" || die "Malformed hairpin permission"
  : > "$runtime/hairpin-next"
  while IFS='|' read -r kind public address proto port vnet target target_vnet gateway extra; do
    [ "$kind" = P ] || continue
    [ -n "$gateway" ] && [ -z "$extra" ] && { [ "$proto" = tcp ] || [ "$proto" = udp ]; } || die "Malformed hairpin permission"
    row="$kind|$public|$address|$proto|$port|$vnet|$target|$target_vnet|$gateway"
    if [ "$action" = stop ] || ! grep -Fx -- "$row" "$config/permissions" >/dev/null || bridge_changed "$address" || bridge_changed "$target"; then
      block
      snapshot_connections P "$public" "$address" "$port" "$target" "$gateway" "$proto"
      printf 'S|%s|%s|none|%s|none|none|none|%s\n' "$address" "$public" "$port" "$proto" >> "$runtime/hairpin-next"
    fi
  done < "$runtime/owned"
  mv "$runtime/hairpin-next" "$runtime/hairpin-pending"
  replay_connections
}
purge() {
  kind=$1 public=$2 address=$3 proto=$4 port=$5
  protocol=$proto
  if [ "$kind" = D ]; then
    delete_connections -D -f ipv6 --zone 0 --orig-dst "$public" -p "$protocol" --dport "$port"
    # The firewall bridge sees the translated private destination.
    delete_connections -D -f ipv6 --zone 1 --orig-dst "$address" -p "$protocol" --dport "$port"
  else
    [ "$proto" != icmp ] || proto=58
    set -- -p "$proto"
    [ "$port" = none ] || set -- "$@" --dport "$port"
    if { [ "$proto" = tcp ] || [ "$proto" = udp ]; } && grep -F "P|$public|$address|$proto|$port|" "$runtime/owned" >/dev/null; then
      : > "$runtime/hairpin-next"
      snapshot_connections E "$public" "$address" "$port" none none "$proto"
      snapshot_connections B "$public" "$address" "$port" none none "$proto"
      mv "$runtime/hairpin-next" "$runtime/hairpin-pending"
      replay_connections
    fi
    delete_connections -D -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$public" "$@"
    # Revoke broken pre-upgrade null-NAT bindings too, without flushing other
    # guests/protocols/ports. Bridge tracking has no public source translation.
    delete_connections -D -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$address" "$@"
    if { [ "$proto" = tcp ] || [ "$proto" = udp ]; } && grep -F "P|$public|$address|$proto|$port|" "$runtime/owned" >/dev/null; then
      # Routed and independent source-bridge tuples were journaled above.
      :
    else
      delete_connections -D -f ipv6 --zone 1 --orig-src "$address" "$@"
    fi
  fi
}
# Arm failure protection before preflight or replacement can fail. Reductions
# must not leave the previous, broader grants usable by established flows.
reduction=0
if [ "$1" != stop ] && [ -f "$runtime/owner" ] && [ -f "$runtime/owned" ]; then
  while IFS= read -r line; do
    case "$line" in D\|*|E\|*|P\|*)
      if ! grep -Fx -- "$line" "$config/permissions" >/dev/null; then reduction=1; fi
    ;; esac
  done < "$runtime/owned"
fi
on_exit() {
  result=$?
  trap - 0
  if [ "$result" -ne 0 ] && [ "$reduction" -eq 1 ]; then
    block || echo "Could not install blocking guard; withdraw the HE transport before retrying" >&2
  fi
  exit "$result"
}
trap on_exit 0
trap 'exit 1' HUP INT TERM
for tool in ip conntrack ip6tables-save; do command -v "$tool" >/dev/null || die "Missing prerequisite: $tool"; done
if [ "$1" = stop ]; then
  if [ -f "$runtime/owned" ]; then
    block
    prepare_hairpin_cleanup stop
    while IFS='|' read -r kind public address proto port vnet; do
      case "$kind" in D|E) purge "$kind" "$public" "$address" "$proto" "$port" ;; esac
    done < "$runtime/owned"
  fi
  if nft list table ip6 "$table" >/dev/null 2>&1; then nft delete table ip6 "$table"; fi
  rm -f "$runtime/owner" "$runtime/owned" "$runtime/state" "$runtime/bridge-zones" "$runtime/zone-candidates" "$runtime/block.nft" "$runtime/transaction.nft" "$runtime/conntrack.log" "$runtime/enumeration" "$runtime/hairpin-next"
  exit 0
fi
# Routed NAT is zone 0, with only owned legacy firewall bridges in zone 1.
# Refuse foreign zone/NAT ownership rather than modifying its configuration.
raw=$(ip6tables-save)
if printf '%s\n' "$raw" | grep -E -- '-j CT.*--zone' >/dev/null; then die "Conflicting IPv6 conntrack zone rule; expected zone 0"; fi
tables=$(nft list tables)
printf '%s\n' "$tables" | while read -r word family name; do
  case "$family" in ip6|inet)
    [ "$name" != "$table" ] || continue
    other=$(nft list table "$family" "$name")
    if printf '%s\n' "$other" | grep -E 'ct zone set|dnat( ip6| ip)? to|snat( ip6| ip)? to|masquerade' >/dev/null; then die "Conflicting IPv6/inet NAT or zone table: $name"; fi
  ;; esac
done
ip link show dev hsp-he6 >/dev/null || die "Apply host-config before IPv6 ingress"
awk -F '|' '$1 == "P" && (NF != 9 || ($4 != "tcp" && $4 != "udp") || $9 == "") { exit 1 }' "$config/permissions" || die "Malformed hairpin permission"
while IFS='|' read -r kind public address proto port vnet target target_vnet gateway extra; do
  case "$kind" in P)
    [ -n "$gateway" ] && [ -z "$extra" ] && { [ "$proto" = tcp ] || [ "$proto" = udp ]; } || die "Malformed hairpin permission"
    ip link show dev "$vnet" >/dev/null || die "Missing guest VNet $vnet; apply SDN first"
    ip link show dev "$target_vnet" >/dev/null || die "Missing guest VNet $target_vnet; apply SDN first"
  ;; D|E) ip link show dev "$vnet" >/dev/null || die "Missing guest VNet $vnet; apply SDN first" ;; esac
done < "$config/permissions"
if [ -f "$runtime/owned" ]; then
  [ "$(sed -n '1p' "$runtime/owned")" = "$(sed -n '1p' "$config/permissions")" ] || die "Disable both roots before IPv6 topology changes"
fi
# Record the union BEFORE activating new rules, so failure recovery owns new flows too.
{
  sed -n '1p' "$config/permissions"
  { if [ -f "$runtime/owned" ]; then sed '1d' "$runtime/owned"; fi; sed '1d' "$config/permissions"; } | sort -u
} > "$runtime/pending"
mv "$runtime/pending" "$runtime/owned"
printf '%s\n' "$owner" > "$runtime/owner"
prepare_hairpin_cleanup reload
if [ ! -f "$runtime/bridge-zones" ] || ! cmp -s "$config/bridge-zones" "$runtime/bridge-zones"; then
  # Block before changing tracking context. Old zone-0 bridge traversals may
  # already have committed null NAT bindings; new rules cannot repair them.
  block
  # Only guests whose bridge context changed need their bindings migrated.
  # Adding a new guest must not reset established sessions on other bridges.
  {
    if [ -f "$runtime/bridge-zones" ]; then cat "$runtime/bridge-zones"; fi
    cat "$config/bridge-zones"
  } | sort -u > "$runtime/zone-candidates"
  while IFS='|' read -r bridge changed_address; do
    [ -n "$bridge" ] && [ -n "$changed_address" ] || continue
    row="$bridge|$changed_address"
    if [ -f "$runtime/bridge-zones" ] && grep -Fx -- "$row" "$runtime/bridge-zones" >/dev/null && grep -Fx -- "$row" "$config/bridge-zones" >/dev/null; then continue; fi
    while IFS='|' read -r kind public address proto port vnet; do
      case "$kind" in D|E)
        [ "$address" != "$changed_address" ] || purge "$kind" "$public" "$address" "$proto" "$port"
      ;; esac
    done < "$runtime/owned"
  done < "$runtime/zone-candidates"
fi
while IFS='|' read -r kind public address proto port vnet; do
  case "$kind" in D|E)
    line="$kind|$public|$address|$proto|$port|$vnet"
    if ! grep -Fx -- "$line" "$config/permissions" >/dev/null; then
      block
      purge "$kind" "$public" "$address" "$proto" "$port"
    fi
  ;; esac
done < "$runtime/owned"
# Old D selectors include every binding to the public port. Complete their
# cleanup under the guard before accepting any replacement-target connection.
transaction "$config/rules.nft"
cp "$config/permissions" "$runtime/state"
cp "$config/permissions" "$runtime/owned"
cp "$config/bridge-zones" "$runtime/bridge-zones"
