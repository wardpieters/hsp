#!/bin/sh
# hsp-network-helper: scoped IPv6 NAT and connection revocation.
set -eu
umask 077
export LC_ALL=C
runtime=${RUNTIME_DIRECTORY:-/run/hsp-ipv6-ingress}
config=${CONFIGURATION_DIRECTORY:-/etc/hsp-ipv6-ingress}
table=hsp_he_ingress
owner=hsp:ipv6-edge:v1
die() { echo "$*" >&2; exit 1; }
case "${1:-}" in start|reload|stop) ;; *) die "Expected start|reload|stop" ;; esac
command -v nft >/dev/null || die "Missing prerequisite: nft; restore nft before reconciling owned state"
if current=$(nft list table ip6 "$table" 2>/dev/null); then
  [ -f "$runtime/owner" ] && echo "$current" | grep -F "$owner" >/dev/null || die "Foreign IPv6 NAT table collision"
fi
mkdir -p "$runtime"
chmod 700 "$runtime"
transaction() {
  body=$1
  { if nft list table ip6 "$table" >/dev/null 2>&1; then echo "delete table ip6 $table"; fi; cat "$body"; } > "$runtime/transaction.nft"
  nft -c -f "$runtime/transaction.nft"
  nft -f "$runtime/transaction.nft"
}
block() {
  header=$(sed -n '1p' "$runtime/owned")
  old_ula=$(printf '%s\n' "$header" | cut -d '|' -f 3)
  cat > "$runtime/block.nft" <<NFT
table ip6 $table {
 comment "$owner"
 chain forward {
  type filter hook forward priority -10; policy accept;
  iifname "hsp-he6" drop
  oifname "hsp-he6" drop
  ip6 saddr $old_ula drop
  ip6 daddr $old_ula drop
 }
}
NFT
  transaction "$runtime/block.nft"
}
delete_connections() {
  if ! conntrack "$@" > "$runtime/conntrack.log" 2>&1; then
    if grep -F '0 flow entries have been deleted' "$runtime/conntrack.log" >/dev/null && ! grep -Ei 'error|failed|not permitted' "$runtime/conntrack.log" >/dev/null; then return 0; fi
    block
    cat "$runtime/conntrack.log" >&2
    die "IPv6 conntrack cleanup failed; blocking guard retained"
  fi
}
purge() {
  kind=$1 public=$2 address=$3 proto=$4 port=$5
  if [ "$kind" = D ]; then
    delete_connections -D -f ipv6 --zone 0 --orig-dst "$public" -p tcp --dport "$port"
    # The firewall bridge sees the translated private destination.
    delete_connections -D -f ipv6 --zone 1 --orig-dst "$address" -p tcp --dport "$port"
  else
    [ "$proto" != icmp ] || proto=58
    set -- -p "$proto"
    [ "$port" = none ] || set -- "$@" --dport "$port"
    delete_connections -D -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$public" "$@"
    # Revoke broken pre-upgrade null-NAT bindings too, without flushing other
    # guests/protocols/ports. Bridge tracking has no public source translation.
    delete_connections -D -f ipv6 --zone 0 --orig-src "$address" --reply-dst "$address" "$@"
    delete_connections -D -f ipv6 --zone 1 --orig-src "$address" "$@"
  fi
}
# Arm failure protection before preflight or replacement can fail. Reductions
# must not leave the previous, broader grants usable by established flows.
reduction=0
if [ "$1" != stop ] && [ -f "$runtime/owner" ] && [ -f "$runtime/owned" ]; then
  while IFS= read -r line; do
    case "$line" in D\|*|E\|*)
      if ! grep -Fx -- "$line" "$config/permissions" >/dev/null; then reduction=1; fi
    ;; esac
  done < "$runtime/owned"
fi
on_exit() {
  result=$?
  trap - 0
  if [ "$result" -ne 0 ] && [ "$reduction" -eq 1 ]; then
    block || echo "Could not install blocking guard; withdraw the HE transport before retrying" >&2
  fi
  exit "$result"
}
trap on_exit 0
trap 'exit 1' HUP INT TERM
for tool in ip conntrack ip6tables-save; do command -v "$tool" >/dev/null || die "Missing prerequisite: $tool"; done
if [ "$1" = stop ]; then
  if [ -f "$runtime/owned" ]; then
    block
    while IFS='|' read -r kind public address proto port vnet; do
      case "$kind" in D|E) purge "$kind" "$public" "$address" "$proto" "$port" ;; esac
    done < "$runtime/owned"
  fi
  if nft list table ip6 "$table" >/dev/null 2>&1; then nft delete table ip6 "$table"; fi
  rm -f "$runtime/owner" "$runtime/owned" "$runtime/state" "$runtime/bridge-zones" "$runtime/zone-candidates" "$runtime/block.nft" "$runtime/transaction.nft" "$runtime/conntrack.log"
  exit 0
fi
# Routed NAT is zone 0, with only owned legacy firewall bridges in zone 1.
# Refuse foreign zone/NAT ownership rather than modifying its configuration.
raw=$(ip6tables-save)
if printf '%s\n' "$raw" | grep -E -- '-j CT.*--zone' >/dev/null; then die "Conflicting IPv6 conntrack zone rule; expected zone 0"; fi
tables=$(nft list tables)
printf '%s\n' "$tables" | while read -r word family name; do
  case "$family" in ip6|inet)
    [ "$name" != "$table" ] || continue
    other=$(nft list table "$family" "$name")
    if printf '%s\n' "$other" | grep -E 'ct zone set|dnat( ip6| ip)? to|snat( ip6| ip)? to|masquerade' >/dev/null; then die "Conflicting IPv6/inet NAT or zone table: $name"; fi
  ;; esac
done
ip link show dev hsp-he6 >/dev/null || die "Apply host-config before IPv6 ingress"
while IFS='|' read -r kind public address proto port vnet; do
  case "$kind" in D|E) ip link show dev "$vnet" >/dev/null || die "Missing guest VNet $vnet; apply SDN first" ;; esac
done < "$config/permissions"
if [ -f "$runtime/owned" ]; then
  [ "$(sed -n '1p' "$runtime/owned")" = "$(sed -n '1p' "$config/permissions")" ] || die "Disable both roots before IPv6 topology changes"
fi
# Record the union BEFORE activating new rules, so failure recovery owns new flows too.
{
  sed -n '1p' "$config/permissions"
  { if [ -f "$runtime/owned" ]; then sed '1d' "$runtime/owned"; fi; sed '1d' "$config/permissions"; } | sort -u
} > "$runtime/pending"
mv "$runtime/pending" "$runtime/owned"
printf '%s\n' "$owner" > "$runtime/owner"
if [ ! -f "$runtime/bridge-zones" ] || ! cmp -s "$config/bridge-zones" "$runtime/bridge-zones"; then
  # Block before changing tracking context. Old zone-0 bridge traversals may
  # already have committed null NAT bindings; new rules cannot repair them.
  block
  # Only guests whose bridge context changed need their bindings migrated.
  # Adding a new guest must not reset established sessions on other bridges.
  {
    if [ -f "$runtime/bridge-zones" ]; then cat "$runtime/bridge-zones"; fi
    cat "$config/bridge-zones"
  } | sort -u > "$runtime/zone-candidates"
  while IFS='|' read -r bridge changed_address; do
    [ -n "$bridge" ] && [ -n "$changed_address" ] || continue
    row="$bridge|$changed_address"
    if [ -f "$runtime/bridge-zones" ] && grep -Fx -- "$row" "$runtime/bridge-zones" >/dev/null && grep -Fx -- "$row" "$config/bridge-zones" >/dev/null; then continue; fi
    while IFS='|' read -r kind public address proto port vnet; do
      case "$kind" in D|E)
        [ "$address" != "$changed_address" ] || purge "$kind" "$public" "$address" "$proto" "$port"
      ;; esac
    done < "$runtime/owned"
  done < "$runtime/zone-candidates"
fi
transaction "$config/rules.nft"
while IFS='|' read -r kind public address proto port vnet; do
  case "$kind" in D|E)
    line="$kind|$public|$address|$proto|$port|$vnet"
    if ! grep -Fx -- "$line" "$config/permissions" >/dev/null; then purge "$kind" "$public" "$address" "$proto" "$port"; fi
  ;; esac
done < "$runtime/owned"
cp "$config/permissions" "$runtime/state"
cp "$config/permissions" "$runtime/owned"
cp "$config/bridge-zones" "$runtime/bridge-zones"
