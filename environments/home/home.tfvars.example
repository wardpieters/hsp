# Illustrative inventory only. Replace these values after inspecting your network.
# Copy to home.tfvars (ignored by Git). Keep credentials in environment variables.
proxmox_endpoint     = "https://192.168.50.10:8006/"
proxmox_insecure_tls = false # Set true to skip Proxmox certificate verification.
pihole_url           = "https://192.168.50.53"
pihole_insecure_tls  = false # Set true to skip Pi-hole certificate verification.
node_name            = "pve"
# Optional host access for raw per-guest lxc_mounts/lxc_cgroups; uses your SSH agent.
# proxmox_ssh = { host = "192.168.50.10", user = "root" }
host_address         = "192.168.50.10"
platform_cidr        = "10.77.0.0/24"
protected_cidrs      = ["192.168.50.0/24", "10.78.0.0/24", "10.79.0.0/24"]
bootstrap_admin_cidrs = ["192.168.50.42/32"]
public_ports_lan_cidrs = ["192.168.50.0/24"] # LAN access to each VM's public_ports; default [].
service_access_cidrs = ["192.168.50.0/24"] # Private proxy TCP 443 only; default [].
manage_host_firewall = false # Opt in only after reviewing/importing existing rules.
dns_servers         = ["192.168.50.53"]
domain              = "home.example.com"
ntp_servers         = [] # Use the guest's configured NTP pool instead of fixed-IP exceptions.
internet_egress_ports = [{ protocol = "udp", port = 123 }] # Shared by every VM.
vm_template_id      = 9000 # Renamed from template_id; used only by VM guests.
# Required only when declaring LXC guests. Use the archive already on your host.
lxc_template = {
  file_id = "local:vztmpl/REPLACE_WITH_DOWNLOADED_TEMPLATE.tar.zst"
  os_type = "debian" # Defaults to debian; match the template's distribution.
}
datastore_id        = "local-lvm"
ssh_public_keys     = ["REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"]
private_proxy_name  = "proxy-private"
http_proxy_name     = "http-proxy" # Every other guest may reach this VM on TCP 3128.

# New guests start stopped, without autostart. Configure VPN/proxy software later.
# VMs default to backup = true; set backup = false to exclude the root disk.
# Extra VM disks each default to backup = true independently of the root disk.
# LXC rootfs backups follow job selection; configure extra-volume backups per mount.
# Per-VM internet egress adds to the global list, e.g. [{ protocol = "tcp", port = 443 }].
guests = {
  vpn-admin = {
    vm_id = 1000, slot = 0, vnet_id = "hsp110", role = "admin_vpn"
    bootstrap = false # Set true for SSH from bootstrap_admin_cidrs during setup.
    public_ports = [{ protocol = "udp", port = 51820 }]
    internet_egress_ports = []
  }
  vpn-family = {
    vm_id = 1001, slot = 1, vnet_id = "hsp111", role = "service_vpn"
    public_ports = [{ protocol = "udp", port = 51821 }]
    internet_egress_ports = []
  }
  proxy-public = {
    vm_id = 1002, slot = 2, vnet_id = "hsp112", role = "public_proxy"
    public_ports = [{ protocol = "tcp", port = 80 }, { protocol = "tcp", port = 443 }]
    internet_egress_ports = []
  }
  proxy-private = {
    vm_id = 1003, slot = 3, vnet_id = "hsp113", role = "private_proxy"
    internet_egress_ports = []
  }
  cloud = {
    vm_id = 1004, slot = 4, vnet_id = "hsp114"
    ssd = true # VM root-disk SSD emulation; defaults to false.
    # VM-only new data volumes. Keep interface keys stable; scsi0 is the root.
    # Format and mount these disks inside the VM after provisioning.
    extra_disks = {
      scsi1 = { size_gb = 100, ssd = true } # Uses datastore_id; included in backups.
      # scsi2 = { size_gb = 8, datastore_id = "fast-lvm", backup = false }
    }
    dns = { cloud = { mode = "proxy", proxy_name = "proxy-private" }, cloud-host = { mode = "direct" } }
    internet_egress_ports = []
  }
  web = {
    vm_id = 1005, slot = 5, vnet_id = "hsp115"
    dns = { web = { mode = "proxy", proxy_name = "proxy-public" } }
    internet_egress_ports = []
  }
  http-proxy = {
    vm_id = 1006, slot = 6, vnet_id = "hsp1006"
    backup = false
    public_ports = []
    internet_egress_ports = [{ protocol = "tcp", port = 80 }, { protocol = "tcp", port = 443 }]
    dns = { http-proxy = { mode = "direct" } }
    cores = 1
    memory_mb = 512
  }
  files = {
    type = "lxc" # Omit type for a VM.
    nesting = false # Set true to enable Proxmox nesting=1 for this LXC.
    # Raw bind mounts/cgroup2 rules require proxmox_ssh above; applied at next restart.
    # lxc_mounts = ["/dev/dri dev/dri none bind,optional,create=dir"]
    # lxc_cgroups = { "devices.allow" = ["c 226:0 rwm", "c 226:128 rwm"] }
    vm_id = 1007, slot = 7, vnet_id = "hsp1007"
    cores = 1
    memory_mb = 512
    disk_gb = 8
    mount_points = [
      { path = "/srv/data", size_gb = 50 }, # Uses datastore_id; included in backups.
      { path = "/srv/cache", size_gb = 8, datastore_id = "local-lvm", backup = false },
    ]
    dns = { files = { mode = "direct" } }
  }
}
connections = [
  { from = "proxy-private", to = "cloud", protocol = "tcp", port = 8080 },
  { from = "proxy-public", to = "web", protocol = "tcp", port = 8080 },
  # Allow one external host to reach a guest:
  # { from = "192.168.50.42/32", to = "cloud", protocol = "tcp", port = 443 },
  # Temporary migration access to a server outside this inventory:
  # { from = "http-proxy", to = "172.16.10.30", protocol = "tcp", port = 80 },
  # { from = "http-proxy", to = "172.16.10.30", protocol = "tcp", port = 443 },
]
