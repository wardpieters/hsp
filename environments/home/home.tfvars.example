# Illustrative inventory only. Replace these values after inspecting your network.
# Copy to home.tfvars (ignored by Git). Keep credentials in environment variables.
proxmox_endpoint     = "https://192.168.50.10:8006/"
proxmox_insecure_tls = false # Set true to skip Proxmox certificate verification.
pihole_url           = "https://192.168.50.53"
pihole_insecure_tls  = false # Set true to skip Pi-hole certificate verification.
node_name            = "pve"
host_address         = "192.168.50.10"
platform_cidr        = "10.77.0.0/24"
protected_cidrs      = ["192.168.50.0/24", "10.78.0.0/24", "10.79.0.0/24"]
bootstrap_admin_cidrs = ["192.168.50.42/32"]
public_ports_lan_cidrs = ["192.168.50.0/24"] # LAN access to each VM's public_ports; default [].
manage_host_firewall = false # Opt in only after reviewing/importing existing rules.
dns_servers         = ["192.168.50.53"]
ntp_servers         = ["192.168.50.1"] # Must actually provide NTP; replace if it doesn't.
template_id         = 9000
datastore_id        = "local-lvm"
ssh_public_keys     = ["REPLACE_WITH_YOUR_SSH_PUBLIC_KEY"]
private_proxy_name  = "proxy-private"
http_proxy_name     = "http-proxy" # Every other guest may reach this VM on TCP 3128.

# New guests start stopped, without autostart. Configure VPN/proxy software later.
# Each guest defaults to backup = true; set backup = false to exclude its disk.
# Internet egress defaults to []; opt in per VM, e.g. [{ protocol = "tcp", port = 443 }].
guests = {
  vpn-admin = {
    vm_id = 1000, slot = 0, vnet_id = "hsp110", role = "admin_vpn"
    bootstrap = false # Set true for SSH from bootstrap_admin_cidrs during setup.
    public_ports = [{ protocol = "udp", port = 51820 }]
    internet_egress_ports = []
  }
  vpn-family = {
    vm_id = 1001, slot = 1, vnet_id = "hsp111", role = "service_vpn"
    public_ports = [{ protocol = "udp", port = 51821 }]
    internet_egress_ports = []
  }
  proxy-public = {
    vm_id = 1002, slot = 2, vnet_id = "hsp112", role = "public_proxy"
    public_ports = [{ protocol = "tcp", port = 80 }, { protocol = "tcp", port = 443 }]
    internet_egress_ports = []
  }
  proxy-private = {
    vm_id = 1003, slot = 3, vnet_id = "hsp113", role = "private_proxy"
    internet_egress_ports = []
  }
  cloud = {
    vm_id = 1004, slot = 4, vnet_id = "hsp114"
    dns = { cloud = { mode = "proxy", proxy_name = "proxy-private" }, cloud-host = { mode = "direct" } }
    internet_egress_ports = []
  }
  web = {
    vm_id = 1005, slot = 5, vnet_id = "hsp115"
    dns = { web = { mode = "proxy", proxy_name = "proxy-public" } }
    internet_egress_ports = []
  }
  http-proxy = {
    vm_id = 1006, slot = 6, vnet_id = "hsp1006"
    backup = false
    public_ports = []
    internet_egress_ports = [{ protocol = "tcp", port = 80 }, { protocol = "tcp", port = 443 }]
    dns = { http-proxy = { mode = "direct" } }
    cores = 1
    memory_mb = 512
  }
}
connections = [
  { from = "proxy-private", to = "cloud", protocol = "tcp", port = 8080 },
  { from = "proxy-public", to = "web", protocol = "tcp", port = 8080 },
  # Temporary migration access to a server outside this inventory:
  # { from = "http-proxy", to = "172.16.10.30", protocol = "tcp", port = 80 },
  # { from = "http-proxy", to = "172.16.10.30", protocol = "tcp", port = 443 },
]
